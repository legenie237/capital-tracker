# Copiez ce fichier en .env.local et remplissez avec les valeurs de votre projet Supabase
# (Supabase > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre-cle-anon
# URL publique du site (utilisée dans les emails de confirmation)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Coach IA (côté serveur uniquement, ne jamais exposer)
ANTHROPIC_API_KEY=
# Optionnel : autre modèle Claude pour le coach
# COACH_MODEL=claude-opus-5-5
# Paiement crypto (optionnel, côté serveur uniquement, ne jamais exposer)
# Sans ces 3 variables, le paiement crypto est simplement masqué.
SUPABASE_SERVICE_ROLE_KEY=
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
